# Autor: Pedro Tiezo Sales Shimizu
#
# Modelo de configuracao da conexao com o Oracle.
# Copie este arquivo para ".env" (na mesma pasta backend/) e preencha a senha.
# O ".env" esta no .gitignore: a senha nunca vai para o repositorio.

# Usuario do banco criado para a aplicacao (ver README)
BD_USUARIO=demandatrack

# Senha escolhida no CREATE USER
BD_SENHA=

# Endereco do banco: servidor:porta/servico. No Oracle XE local e este:
BD_CONEXAO=localhost:1521/xepdb1
